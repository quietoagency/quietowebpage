---
interface Props {
  withWordmark?: boolean;
  mode?: "light" | "dark";
}
const { withWordmark = false, mode = "light" } = Astro.props;
const inkClass = mode === "dark" ? "stroke-foam-50" : "stroke-tint-500";
const wordmarkClass = mode === "dark" ? "text-foam-50" : "text-tint-500";
---

<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 104 136" fill="none" class="block h-7 w-auto" role="img" aria-label="quieto">
    <circle cx="50" cy="50" r="41" stroke-width="11" class={inkClass} />
    <path d="M91 52 L91 128" stroke-width="11" stroke-linecap="round" class={inkClass} />
    <path
      d="M22 56 C31 47 41 47 50 56 C59 65 69 65 78 56"
      stroke-width="11"
      stroke-linecap="round"
      fill="none"
      class="stroke-water-500"
    />
  </svg>
  {
    withWordmark && (
      <span class={`font-wordmark tracking-wordmark text-h3 leading-none ${wordmarkClass}`}>quieto</span>
    )
  }
</span>

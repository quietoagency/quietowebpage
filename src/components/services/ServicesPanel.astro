---
interface Props {
  services: {
    title: string;
    lead: string;
    items: { t: string; d: string }[];
  }[];
}
const { services } = Astro.props;
---

<section
  id="services-detail"
  hidden
  aria-live="polite"
  class="box-border flex min-h-svh items-center border-t border-fog-300"
>
  <div class="mx-auto w-full max-w-content box-border px-content-x">
    {
      services.map((s, i) => (
        <div
          data-panel
          data-index={i}
          hidden
          class="grid grid-cols-services-hero gap-services-gap py-section-y max-mobile:grid-cols-1 max-mobile:gap-6 max-mobile:py-9"
        >
          <div
            data-reveal
            style="transition-delay:0.05s"
            class="translate-y-3 text-xs uppercase tracking-eyebrow text-fog-500 opacity-0 transition duration-500 ease-out"
          >
            {String(i + 1).padStart(2, "0")} — {s.title}
          </div>
          <div class="max-w-narrow">
            <p
              data-reveal
              style="transition-delay:0.1s"
              class="m-0 mb-12 text-pretty font-display text-h2 leading-tight text-tint-500 opacity-0 translate-y-3 transition duration-500 ease-out max-mobile:mb-6"
            >
              {s.lead}
            </p>
            <div class="flex flex-col">
              {s.items.map((it, j) => (
                <div
                  data-reveal
                  style={`transition-delay:${(0.25 + j * 0.15).toFixed(2)}s`}
                  class="flex items-baseline gap-8 border-b border-fog-300 py-6 opacity-0 translate-y-3 transition duration-500 ease-out max-mobile:gap-4 max-mobile:py-4"
                >
                  <span class="w-7 shrink-0 text-xs text-fog-400">{String(j + 1).padStart(2, "0")}</span>
                  <div>
                    <div class="mb-1.5 text-lg font-medium text-tint-500">{it.t}</div>
                    <p class="m-0 text-sm leading-relaxed text-fog-500">{it.d}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

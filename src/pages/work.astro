---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WorkShowcase from "../components/work/WorkShowcase.astro";
import { SEO } from "astro-seo";
import { projects } from "../lib/constants";
---

<html lang="es" class="scroll-smooth">
  <head>
    <SEO
      title="trabajo - quieto"
      description="Proyectos de diseño y desarrollo que hicimos en quieto: identidad, sitios y e-commerce pensados para sostenerse en el tiempo."
      openGraph={{
        basic: {
          title: "trabajo - quieto",
          type: "website",
          image: "/media/images/logoimage.png",
        },
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.svg" }],
      }}
    />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>trabajo - quieto</title>
  </head>
  <body class="bg-foam-500 selection:bg-water-500 selection:text-foam-50">
    <Header />

    <WorkShowcase projects={projects} />

    <Footer />
  </body>
</html>
